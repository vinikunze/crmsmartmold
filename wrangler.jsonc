{
  // em dia.: água e refeições do casal. Site, API e banco num Worker só.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "em-dia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Só o endereço principal. Endereços de pré-visualização seriam mais portas
  // para proteger no Access, sem uso para duas pessoas.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // A API passa pelo Worker; o resto (HTML, JS, CSS, ícones) sai direto do cache.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "em-dia",
      "database_id": "5c6d87af-a9f0-48cc-ade5-435062042c9f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Segunda trava, além do Access: só estes e-mails passam pela API.
    "EMAILS_PERMITIDOS": "vinihkunze@gmail.com,sluise981@gmail.com"
  },
  // Só para rodar no computador: simula o login do Access.
  "access": {
    "dev": {
      "aud": "dev-local",
      "identity": { "email": "vinihkunze@gmail.com" }
    }
  },
  "observability": { "enabled": true }
}
